      "css": ".ds-shot-toolbar{display:flex;align-items:center;justify-content:space-between;gap:24px;padding:15px 22px;background:var(--paper,#fafaf7);color:var(--ink,#2b342d);border-bottom:1px solid #d4dbcf;font-family:\"Microsoft YaHei\",\"PingFang SC\",system-ui,sans-serif}.ds-shot-toolbar h2{font:600 24px/1.45 \"Microsoft YaHei\",\"PingFang SC\",system-ui,sans-serif;margin:0}.ds-shot-toolbar button{font:400 22px/1.6 \"Microsoft YaHei\",\"PingFang SC\",system-ui,sans-serif;padding:9px 18px;border:1px solid #a7b69d;border-radius:4px;background:#fafaf7;color:#2b342d;cursor:pointer}"
    }
  ],
  "narrative": {
    "northStar": "品记的纸页",
    "overview": "沿用品记的深绿、暖白和清晰中文。短句说明产品，真实应用截图呈现笔记、版本与分享；两幅生活场景插图只承担情境。\n\n本文件仅约束 docs/pitch 的产品截图版。应用界面取自当前代码的显式开发预览，载入虚构范例1；分享图片由应用实际导出。当前像素、样式与行为以 index.html、pitch.css、pitch.js 和 assets/manifest.json 为准。应用本身的设计系统未改动。",
    "keyCharacteristics": [
      "先给产品定义与价值，再用真实画面说明操作。",
      "截图保留可读字号，宽图局部滚动，不缩成微型文字。",
      "当前截图可原像素展开，分享模式切换真实图片。",
      "开发预览、虚构范例与 AI 场景图各自明确标注。"
    ],
    "dos": [
      "Do 延用品记图标、深绿与暖白，只更新提案本身。",
      "Do 核对文字的实际显示尺寸，包括截图中的文字。",
      "Do 保留截图来源、区域、虚构数据及 AI 图注。",
      "Do 修改源文件后重新打包，保持单文件与源文件一致。"
    ],
    "donts": [
      "Don't 用重绘 DOM 冒充应用截图。",
      "Don't 为适应栏宽将截图文字缩到 18px 以下。",
      "Don't 加入在线字体、远程图片、账号或追踪依赖。",
      "Don't 把开发预览或虚构资料库包装成真实用户反馈。"
    ],
    "rules": [
      {
        "name": "Readable Chinese",
        "section": "typography",
        "body": "所有可读文字至少 18 CSS px；截图按来源字号与显示比例核对，不用缩字适应空间。"
      }
    ]
  }
}
