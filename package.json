{
  "name": "tistnote",
  "version": "0.2.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && vite build --mode pages --base=/tistnote/ --outDir dist-pages",
    "build:android": "tsc -b && vite build --mode android --base=./ --outDir dist-android",
    "package:android": "pwsh -NoProfile -File scripts/package-android.ps1",
    "test": "tsx --test tests/*.test.ts",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "package": "tauri build",
    "package:offline": "tauri build --config src-tauri/tauri.offline.conf.json"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.0"
  }
}
